{
  "name": "incident-atlas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "verify:production-api": "node scripts/production-api-config.mjs",
    "build": "npm run verify:production-api && tsc -b && vite build",
    "test:e2e": "node tests/browser-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -p tsconfig.integration.json && node tests/prepare.mjs && node --test tests/integration.mjs tests/production-api-config.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1"
  }
}
